# ============================================================================
# Hermes Framework — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# The supervisor loads .env automatically at startup.
# All values here can also be passed as CLI arguments (CLI wins over .env).
# ============================================================================

# ── Cluster Connection ───────────────────────────────────────────────────────
HERMES_REMOTE_HOST=api.mycluster.example.com
HERMES_REMOTE_USER=root
HERMES_SSH_PASSWORD=
HERMES_REMOTE_BASE=/root/DS_Hermes_Framework

# ── CPD Credentials ──────────────────────────────────────────────────────────
CPD_URL=https://cpd-ds.apps.mycluster.example.com
CPD_USERNAME=cpadmin
CPD_PASSWORD=

# ── Test Configuration ───────────────────────────────────────────────────────
HERMES_PRODUCT=datastage
HERMES_EXTRA_DIR=/home/user/Desktop/cpd-perf-automation
HERMES_MAX_WORKERS=4
HERMES_MAX_RETRIES=1

# ── AI Model Configuration ──────────────────────────────────────────────────
HERMES_MODEL=gemma4:12b
HERMES_MODEL_FAST=gemma4:12b
HERMES_MODEL_ANALYST=gemma4:12b
OLLAMA_NUM_PARALLEL=4

# ── Optional ─────────────────────────────────────────────────────────────────
# HERMES_SKIP_SETUP=1
# HERMES_EXECUTION=sequential
